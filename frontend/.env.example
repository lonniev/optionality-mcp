# Optionality frontend — environment template.
# Copy to .env (untracked) and adjust for your deployment.

# MCP endpoint URL.
#
# For Cloudflare Pages production:  /mcp  (same-origin via functions/mcp.js proxy)
# For local Vite dev pointed at FastMCP Cloud: https://optionality-mcp.fastmcp.app/mcp
# For local Vite dev pointed at a local server:  http://localhost:8000/mcp
VITE_MCP_URL=/mcp
