{
  "name": "optionality-frontend",
  "version": "0.7.4",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/fetch-anthropic-pricing.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "verify:modeler": "esbuild verify/externalModeler.smoke.ts --bundle --format=esm --platform=node | node --input-type=module",
    "verify:proof": "esbuild verify/proofExpiry.smoke.ts --bundle --format=esm --platform=node | node --input-type=module",
    "verify:claimcheck": "esbuild verify/claimCheck.smoke.ts --bundle --format=esm --platform=node | node --input-type=module",
    "verify:sessionkey": "esbuild verify/sessionKey.smoke.ts --bundle --format=esm --platform=node | node --input-type=module",
    "verify:dealclock": "esbuild verify/dealClock.smoke.ts --bundle --format=esm --platform=node | node --input-type=module",
    "verify:pending": "esbuild verify/pendingDeals.smoke.ts --bundle --format=esm --platform=node | node --input-type=module",
    "verify": "npm run verify:modeler && npm run verify:proof && npm run verify:claimcheck && npm run verify:sessionkey && npm run verify:dealclock && npm run verify:pending"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "nostr-tools": "^2.23.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.0.0",
    "recharts": "^3.0.0",
    "remark-gfm": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "typescript": "^7.0.0",
    "vite": "^8.0.0"
  }
}
